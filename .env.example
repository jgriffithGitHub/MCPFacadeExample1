# Copy this file to .env and fill in the values.

# Used by the backend's agent loop (Anthropic API).
ANTHROPIC_API_KEY=
MODEL=claude-haiku-4-5

# Used by the facade: the real MCP server it sits in front of.
ATTIO_MCP_URL=https://mcp.attio.com/mcp

# Ports (defaults shown).
FACADE_PORT=3001
HOST_PORT=8080
SANDBOX_PORT=8081
